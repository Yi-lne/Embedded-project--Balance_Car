  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\STM32Projects\Projects\Balance_Car\balance_car_program2\build\Debug\cmake\stm32cubemx && "D:\CLion\CLion 2024.1\bin\cmake\win\x64\bin\cmake.exe" --regenerate-during-build -SD:\STM32Projects\Projects\Balance_Car\balance_car_program2 -BD:\STM32Projects\Projects\Balance_Car\balance_car_program2\build\Debug"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build cmake/stm32cubemx/rebuild_cache: phony cmake/stm32cubemx/CMakeFiles/rebuild_cache.util

